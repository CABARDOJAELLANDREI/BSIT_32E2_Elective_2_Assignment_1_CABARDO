@model List<BSIT_32E2_Elective_2_Assignment_1.Models.QuizQuestion>

@{
    ViewData["Title"] = "Elective 2 - Assignment 1";
}

<div class="container py-4">
    <div class="mb-4 border-bottom pb-3">
        <h1 class="display-6 fw-bold">BSIT 32E2 — Elective 2: Assignment 1</h1>
        <p class="text-muted mb-0">ASP.NET Core MVC &amp; RESTful Web API Concepts</p>
    </div>

    @foreach (var q in Model)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-dark text-white">
                <strong>Question @q.Number</strong>
            </div>    
            <div class="card-body">
                <h5 class="card-title mb-3">@q.QuestionText</h5>

                <ul class="list-group mb-3">
                    @foreach (var option in q.Options) 
                    {
                        var isCorrect = option.Key == q.CorrectOption;
                        <li class="list-group-item @(isCorrect ? "list-group-item-success fw-semibold" : "")">
                            <span><strong>@option.Key)</strong> @option.Value</span>
                            @if (isCorrect)
                            {
                                <span class="badge bg-success float-end">Correct Answer</span>
                            }
                        </li>
                    }  
                </ul>

                <div class="alert alert-light border mb-0">
                    <strong>Answer: @q.CorrectOption</strong> — @q.Explanation
                </div>
            </div>
        </div>
    }
</div>